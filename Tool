# ==================================================================
#  CLOUD (Intune + Entra via Microsoft Graph)
# ==================================================================
function Connect-Cloud {
    if ($Script:GraphConnected) { return $true }
    $need = @('Microsoft.Graph.Authentication', 'Microsoft.Graph.DeviceManagement', 'Microsoft.Graph.Identity.SignIns')
    $missing = @($need | Where-Object { -not (Get-Module -ListAvailable -Name $_) })
    if ($missing.Count -gt 0) {
        Say ('Missing PowerShell modules: ' + ($missing -join ', ')) Yellow
        if (-not (Read-YesNo 'Install them now from the PowerShell Gallery (current user)?' 'N' 30)) { return $false }
        try {
            [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
            if (-not (Get-PackageProvider -ListAvailable -Name NuGet -ErrorAction SilentlyContinue)) {
                Install-PackageProvider -Name NuGet -MinimumVersion 2.8.5.201 -Force -Scope CurrentUser | Out-Null
            }
            Say 'Installing, this can take a few minutes...' DarkGray
            Install-Module -Name $missing -Scope CurrentUser -Force -AllowClobber -ErrorAction Stop
        } catch { Say ('Install failed: ' + $_.Exception.Message) Red; return $false }
    }
    Say 'A Microsoft sign-in window opens. Sign in with your admin account.' Cyan
    try {
        Import-Module Microsoft.Graph.Authentication -ErrorAction Stop
        Connect-MgGraph -Scopes 'DeviceManagementManagedDevices.Read.All', 'DeviceManagementManagedDevices.PrivilegedOperations.All', 'BitlockerKey.Read.All' -ErrorAction Stop | Out-Null
        $ctx = Get-MgContext
        $Script:GraphConnected = $true
        Say ("Connected as {0}." -f $ctx.Account) Green
        Write-Log ("Graph connected: " + $ctx.Account)
        return $true
    } catch { Say ('Sign-in failed: ' + $_.Exception.Message) Red; return $false }
}

function Get-CloudDevices {
    Get-MgDeviceManagementManagedDevice -All -ErrorAction Stop -Property 'id', 'deviceName', 'userPrincipalName', 'operatingSystem', 'osVersion', 'complianceState', 'lastSyncDateTime', 'azureADDeviceId', 'model', 'serialNumber'
}

function Show-CloudDevices {
    Head 'Intune Devices'
    if (-not (Connect-Cloud)) { return }
    Say 'Loading devices...' DarkGray
    $Script:CloudCache = @(Get-CloudDevices)
    $file = Join-Path $Script:FleetDir ("Intune_Devices_{0:yyyy-MM-dd_HHmm}.csv" -f (Get-Date))
    $Script:CloudCache | Select-Object DeviceName, UserPrincipalName, OperatingSystem, OsVersion, ComplianceState, LastSyncDateTime, Model, SerialNumber, AzureAdDeviceId, Id |
        Export-Csv -Path $file -NoTypeInformation -Encoding UTF8
    foreach ($d in ($Script:CloudCache | Sort-Object DeviceName)) {
        $days = 999; if ($d.LastSyncDateTime) { $days = [int]((Get-Date) - $d.LastSyncDateTime).TotalDays }
        $color = 'Gray'
        if ($days -gt 7) { $color = 'Yellow' }
        if ("$($d.ComplianceState)" -eq 'noncompliant') { $color = 'Red' }
        Write-Host ('  {0,-20} {1,-30} {2,-13} synced {3,3}d ago' -f $d.DeviceName, $d.UserPrincipalName, $d.ComplianceState, $days) -ForegroundColor $color
    }
    Write-Host ''
    Say ("{0} devices. Red = noncompliant, Yellow = no sync in 7+ days." -f $Script:CloudCache.Count) Cyan
    Say ("Saved: " + $file) Green
    Write-Log ("Intune device list: " + $file)
}

function Select-CloudDevice {
    if (-not (Connect-Cloud)) { return $null }
    if (-not $Script:CloudCache) { Say 'Loading Intune devices...' DarkGray; $Script:CloudCache = @(Get-CloudDevices) }
    $q = "$(Read-Host 'Device name (or part of it)')".Trim()
    if (-not $q) { return $null }
    $m = @($Script:CloudCache | Where-Object { $_.DeviceName -like "*$q*" } | Sort-Object DeviceName | Select-Object -First 50)
    if ($m.Count -eq 0) { Say 'No matching devices.' Yellow; return $null }
    $i = 0
    foreach ($d in $m) { $i++; Write-Host ('  [{0,2}] ' -f $i) -ForegroundColor Yellow -NoNewline; Write-Host ('{0,-20} {1,-30} {2}' -f $d.DeviceName, $d.UserPrincipalName, $d.ComplianceState) }
    if ($m.Count -eq 1) { return $m[0] }
    $n = "$(Read-Host 'Number')".Trim()
    if ($n -match '^\d+$' -and [int]$n -ge 1 -and [int]$n -le $m.Count) { return $m[[int]$n - 1] }
    return $null
}

function Show-CloudDevice {
    Head 'Find an Intune Device'
    $d = Select-CloudDevice
    if (-not $d) { return }
    $d | Select-Object DeviceName, UserPrincipalName, OperatingSystem, OsVersion, ComplianceState, LastSyncDateTime, Model, SerialNumber, AzureAdDeviceId, Id | Format-List | Out-Both
}

function Sync-CloudDevice {
    Head 'Sync an Intune Device'
    $d = Select-CloudDevice
    if (-not $d) { return }
    if (-not (Read-YesNo ("Send a sync request to {0}?" -f $d.DeviceName) 'N' 20)) { Say 'Cancelled.' Green; return }
    if ($Script:DryRun) { Say ("[DRY RUN] Would sync " + $d.DeviceName) Yellow; return }
    Sync-MgDeviceManagementManagedDevice -ManagedDeviceId $d.Id -ErrorAction Stop
    Say 'Sync request sent. The device checks in next time it is online, usually within minutes.' Green
    Write-Log ("Intune sync sent: " + $d.DeviceName)
}

function Show-CloudBitLocker {
    Head 'BitLocker Keys from Entra ID'
    $d = Select-CloudDevice
    if (-not $d) { return }
    if (-not $d.AzureAdDeviceId) { Say 'This device has no Entra device ID.' Yellow; return }
    Show-SecretBanner
    $keys = @(Get-MgInformationProtectionBitlockerRecoveryKey -Filter ("deviceId eq '{0}'" -f $d.AzureAdDeviceId) -All -ErrorAction Stop)
    if ($keys.Count -eq 0) { Say 'No recovery keys are stored in Entra for this device.' Yellow; return }
    foreach ($k in $keys) {
        $full = Get-MgInformationProtectionBitlockerRecoveryKey -BitlockerRecoveryKeyId $k.Id -Property 'key' -ErrorAction Stop
        $line = "Device: {0}  Created: {1}  Key ID: {2}`r`n  RECOVERY KEY: {3}" -f $d.DeviceName, $k.CreatedDateTime, $k.Id, $full.Key
        Write-Host $line -ForegroundColor White
        if ($Script:LogSecrets) { Write-Log $line }
    }
    Say 'Note: each key you view is recorded in the Entra audit log. That is normal.' DarkGray
}

function Disconnect-Cloud {
    Head 'Disconnect from Microsoft Graph'
    if ($Script:GraphConnected) { try { Disconnect-MgGraph | Out-Null } catch {} }
    $Script:GraphConnected = $false; $Script:CloudCache = $null
    Say 'Disconnected.' Green
}

