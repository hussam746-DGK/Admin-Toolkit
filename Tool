function New-FullReport {
    Head 'Full Report'
    $withSfc = Read-YesNo 'Include SFC verify? Adds 10-20 minutes' 'N' 15
    $file = Join-Path $Script:LogDir ("FullReport_{0}_{1:yyyy-MM-dd_HHmm}.txt" -f $Script:Target, (Get-Date))
    $sections = [ordered]@{
        'TICKET SUMMARY' = { Invoke-OnTarget -ScriptBlock $Script:SB_TicketData | Remove-RemoteInfo | Format-List }
        'SYSTEM INFO'    = { Invoke-OnTarget { systeminfo.exe } }
        'DISKS'          = { Invoke-OnTarget { Get-PhysicalDisk | Select-Object FriendlyName, MediaType, HealthStatus, OperationalStatus } | Remove-RemoteInfo | Format-Table -AutoSize }
        'DISM CHECK'     = { Invoke-OnTarget { DISM.exe /Online /Cleanup-Image /CheckHealth } }
        'NETWORK'        = { Invoke-OnTarget { ipconfig.exe /all } }
        'WINRE'          = { Invoke-OnTarget { reagentc.exe /info } }
        'RECENT ERRORS'  = { Invoke-OnTarget { Get-WinEvent -FilterHashtable @{ LogName = 'System'; Level = 1, 2 } -MaxEvents 20 -ErrorAction SilentlyContinue | Select-Object TimeCreated, Id, ProviderName } | Remove-RemoteInfo | Format-Table -AutoSize }
    }
    foreach ($name in $sections.Keys) {
        Say ("  - " + $name) Gray
        $text = ''
        try { $text = (& $sections[$name] | Out-String -Width 200).Trim() } catch { $text = 'ERROR: ' + $_.Exception.Message }
        Add-Content -Path $file -Value ("===== {0} =====`r`n{1}`r`n" -f $name, $text) -Encoding UTF8
    }
    if ($withSfc) {
        Say '  - SFC VERIFY (the slow one)' Gray
        $code = Invoke-OnTarget { sfc.exe /verifyonly | Out-Null; $LASTEXITCODE }
        Add-Content -Path $file -Value ("===== SFC VERIFY =====`r`nExit code: {0}. Details: C:\Windows\Logs\CBS\CBS.log on the target.`r`n" -f $code) -Encoding UTF8
    }
    Write-Log ("Full report saved: " + $file)
    Write-Host ''
    Say ("Full report saved to: " + $file) Green
}

