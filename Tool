function Invoke-QuickRepair {
    Head 'Quick Repair - Check, then DISM, then SFC'
    Say 'Step 0: health checks before repairing...' Cyan
    $pre = Invoke-OnTarget {
        [pscustomobject]@{
            Disks   = @(Get-PhysicalDisk | Select-Object FriendlyName, HealthStatus)
            Pending = [bool]((Test-Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\RebootPending') -or
                             (Test-Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update\RebootRequired'))
        }
    } | Remove-RemoteInfo | Select-Object -First 1
    $bad = @($pre.Disks | Where-Object { "$($_.HealthStatus)" -ne 'Healthy' })
    if ($bad.Count -gt 0) {
        Say 'STOP: a drive reports it is NOT healthy:' Red
        $bad | Format-Table -AutoSize | Out-Both
        Say 'Back up the user''s data first. Repairs can stress a failing drive.' Red
        if (-not (Read-YesNo 'Continue anyway?' 'N' 20)) { Say 'Cancelled. Nothing was changed.' Green; return }
    } else { Say 'Drives report Healthy.' Green }
    if ($pre.Pending) {
        Say 'A restart is already pending. Restarting first often fixes the problem by itself.' Yellow
        if (-not (Read-YesNo 'Continue without restarting?' 'N' 20)) { Invoke-RestartOffer 'Restart first, then run Quick Repair again if needed.'; return }
    }
    if (-not (Invoke-RestorePointOffer 'Quick Repair')) { Say 'Cancelled. Nothing was changed.' Green; return }
    Write-Host ''
    Say 'Step 1 of 2: DISM Restore Health (repairs the files SFC copies from)' Cyan
    $c1 = Invoke-NativeLive 'DISM.exe' '/Online /Cleanup-Image /RestoreHealth' -Change
    Show-ExitStatus $c1 'C:\Windows\Logs\DISM\dism.log on the target'
    Write-Host ''
    Say 'Step 2 of 2: SFC Scan' Cyan
    $c2 = Invoke-NativeLive 'sfc.exe' '/scannow' -Change -HideRemoteOutput
    Show-ExitStatus $c2 'C:\Windows\Logs\CBS\CBS.log on the target'
    Invoke-RestartOffer 'A restart finishes any repairs SFC made.'
}

