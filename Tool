function Show-Panels {
    Head 'Control Panels'
    $panels = [ordered]@{
        '1' = @('Network Connections', 'ncpa.cpl', $false)
        '2' = @('Programs and Features', 'appwiz.cpl', $false)
        '3' = @('Device Manager', 'devmgmt.msc', $false)
        '4' = @('Computer Management', 'compmgmt.msc', $true)
        '5' = @('Services', 'services.msc', $true)
        '6' = @('Event Viewer', 'eventvwr.msc', $true)
        '7' = @('System Properties', 'sysdm.cpl', $false)
    }
    foreach ($k in $panels.Keys) {
        $label = $panels[$k][0]
        if (-not $Script:IsLocal -and -not $panels[$k][2]) { $label += ' (local only)' }
