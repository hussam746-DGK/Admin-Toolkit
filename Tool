function Invoke-MainAction {
    param([scriptblock]$Action)
    try { & $Action } catch { Say ('ERROR: ' + $_.Exception.Message) Red; Write-Log ('ERROR: ' + $_.Exception.Message) }
    [void](Show-Nav)
}

function Show-TargetMenu {
    Head 'Change Target'
    Write-Host '  [1] ' -ForegroundColor Yellow -NoNewline; Write-Host 'This PC'
    Write-Host '  [2] ' -ForegroundColor Yellow -NoNewline; Write-Host 'Type a computer name'
    Write-Host '  [3] ' -ForegroundColor Yellow -NoNewline; Write-Host 'Browse domain computers'
    Write-Host '  [B] ' -ForegroundColor Yellow -NoNewline; Write-Host 'Back'
    $k = Read-ValidKey @('1', '2', '3', 'B')
    if ($k -eq '1') { Set-Target $env:COMPUTERNAME }
    if ($k -eq '2') { Set-Target (Read-Host 'Computer name') }
    if ($k -eq '3') { Select-DomainComputer }
}

function Test-ToolkitUpdate {
    if (-not $Script:UpdateUrl) { return }
    try {
        $latest = (Invoke-WebRequest -Uri $Script:UpdateUrl -UseBasicParsing -TimeoutSec 5).Content.Trim()
        if ([version]$latest -gt [version]$Script:Version) { $Script:UpdateNotice = "Update available: v$latest (you have v$($Script:Version))" }
    } catch {}
}

function Show-MainMenu {
    while ($true) {
        Update-HeaderInfo
        Show-Header
        if ($Script:UpdateNotice) { Say (' ' + $Script:UpdateNotice) Yellow }
        Write-Host ''
        Write-Host '  [S] Ticket Summary  ' -ForegroundColor Green -NoNewline; Write-Host '<- start here for most tickets' -ForegroundColor DarkGray
        Write-Host ''
        $rows = @(
            @('1', 'Diagnose', '6', 'Power & Boot'),
            @('2', 'Repair', '7', 'Secrets (keys & passwords)'),
            @('3', 'Network', '8', 'Remote & Fleet (domain)'),
            @('4', 'Printing & Apps', '9', 'Cloud (Intune)'),
            @('5', 'Reports & Exports', 'P', 'Plugins')
        )
        foreach ($r in $rows) {
            Write-Host ('  [{0}] ' -f $r[0]) -ForegroundColor Yellow -NoNewline; Write-Host ('{0,-22}' -f $r[1]) -NoNewline
            Write-Host ('[{0}] ' -f $r[2]) -ForegroundColor Yellow -NoNewline; Write-Host $r[3]
        }
        Say ('-' * 62) DarkCyan
        Write-Host '  [T] Change Target   [D] Dry Run on/off   [L] Logs   [Q] Exit' -ForegroundColor Yellow
        Say ('=' * 62) Cyan
        $sel = "$(Read-Host 'Select')".Trim().ToUpper()
        if     ($sel -eq 'S') { Invoke-MainAction { Show-TicketSummary } }
        elseif ($sel -eq '1') { Show-Menu 'DIAGNOSE' $Script:MenuDiagnose }
        elseif ($sel -eq '2') { Show-Menu 'REPAIR' $Script:MenuRepair }
        elseif ($sel -eq '3') { Show-Menu 'NETWORK' $Script:MenuNetwork }
        elseif ($sel -eq '4') { Show-Menu 'PRINTING & APPS' $Script:MenuApps }
        elseif ($sel -eq '5') { Show-Menu 'REPORTS & EXPORTS' $Script:MenuReports }
        elseif ($sel -eq '6') { Show-Menu 'POWER & BOOT' $Script:MenuPower }
        elseif ($sel -eq '7') { Show-Menu 'SECRETS' $Script:MenuSecrets }
        elseif ($sel -eq '8') { Show-Menu 'REMOTE & FLEET' $Script:MenuFleet }
        elseif ($sel -eq '9') { Show-Menu 'CLOUD (INTUNE)' $Script:MenuCloud }
        elseif ($sel -eq 'P') { Invoke-MainAction { Show-Plugins } }
        elseif ($sel -eq 'T') { Show-TargetMenu; Start-Sleep -Seconds 2 }
        elseif ($sel -eq 'D') { $Script:DryRun = -not $Script:DryRun; Write-Log ("Dry Run set to " + $Script:DryRun) }
        elseif ($sel -eq 'L') { Open-Logs }
        elseif ($sel -eq 'Q') { if (Confirm-Exit) { Exit-Toolkit } }
        elseif ($sel) { Say 'Invalid choice.' Red; Start-Sleep -Seconds 1 }
    }
}

