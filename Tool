<#
    IT Administration Repair Toolkit - v4 (PowerShell engine)
    Start it with IT_Toolkit.bat - the launcher handles admin rights.

    Folder layout:
      IT_Toolkit.bat   launcher (admin rights + execution policy)
      IT_Toolkit.ps1   this file
      Plugins\         your own .ps1 add-ons, shown under [P] Plugins
      Logs\            logs, tickets, reports, fleet CSVs
      targets.txt      optional list of computer names for the fleet tools
#>

# ============================ SETTINGS ============================
$Script:Version       = '4.0'
$Script:LogSecrets    = $true   # $true = BitLocker keys and Wi-Fi passwords also go into the full log. $false = screen only.
$Script:LowDiskGB     = 20      # Free space below this shows in red
$Script:LogKeepDays   = 30      # Toolkit logs older than this are deleted at startup
$Script:ThrottleLimit = 32      # How many PCs the fleet tools talk to at once
$Script:UpdateUrl     = ''      # Optional: URL of a text file holding the latest version number. Notify only, never auto-downloads.
# ==================================================================

$isAdmin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
if (-not $isAdmin) {
    Write-Host 'Please start the toolkit with IT_Toolkit.bat - it asks for admin rights.' -ForegroundColor Red
    Read-Host 'Press Enter to close'
    exit 1
}
try { $Host.UI.RawUI.WindowTitle = "IT Administration Repair Toolkit v$($Script:Version)" } catch {}

# ---------- Folders (falls back to ProgramData if the USB/folder is read-only) ----------
$Script:Root   = $PSScriptRoot
$Script:LogDir = Join-Path $Script:Root 'Logs'
try {
    if (-not (Test-Path $Script:LogDir)) { New-Item -ItemType Directory -Path $Script:LogDir -Force -ErrorAction Stop | Out-Null }
    $probe = Join-Path $Script:LogDir '.write_test'
    Set-Content -Path $probe -Value 'x' -ErrorAction Stop
    Remove-Item $probe -Force
} catch {
    $Script:LogDir = Join-Path $env:ProgramData 'ITToolkit\Logs'
    New-Item -ItemType Directory -Path $Script:LogDir -Force | Out-Null
}
$Script:TicketDir = Join-Path $Script:LogDir 'Tickets'
$Script:FleetDir  = Join-Path $Script:LogDir 'Fleet'
$Script:PluginDir = Join-Path $Script:Root 'Plugins'
foreach ($d in $Script:TicketDir, $Script:FleetDir) { if (-not (Test-Path $d)) { New-Item -ItemType Directory -Path $d -Force | Out-Null } }
if (-not (Test-Path $Script:PluginDir)) { try { New-Item -ItemType Directory -Path $Script:PluginDir -Force -ErrorAction Stop | Out-Null } catch {} }
$Script:LogFile = Join-Path $Script:LogDir ("ToolkitLog_{0:yyyy-MM-dd}.txt" -f (Get-Date))

# Delete this toolkit's own logs older than LogKeepDays
Get-ChildItem -Path $Script:LogDir -Filter 'ToolkitLog_*.txt' -ErrorAction SilentlyContinue |
    Where-Object { $_.LastWriteTime -lt (Get-Date).AddDays(-$Script:LogKeepDays) } |
    Remove-Item -Force -ErrorAction SilentlyContinue

# ---------- State ----------
$Script:Target         = $env:COMPUTERNAME
$Script:IsLocal        = $true
$Script:DryRun         = $false
$Script:GraphConnected = $false
$Script:CloudCache     = $null
$Script:HeaderInfo     = $null
$Script:UpdateNotice   = $null

# ==================================================================
#  OUTPUT + LOGGING HELPERS
# ==================================================================
function Say {
    param([string]$Text, [ConsoleColor]$Color = 'Gray')
    Write-Host $Text -ForegroundColor $Color
}

function Write-Log {
    param([string]$Text)
    try { Add-Content -Path $Script:LogFile -Value $Text -Encoding UTF8 -ErrorAction Stop } catch {}
}

function Write-LogHeader {
    param([string]$Title)
    Write-Log ''
    Write-Log ("===== {0} | Target: {1} | {2:yyyy-MM-dd HH:mm:ss} =====" -f $Title, $Script:Target, (Get-Date))
}

function Out-Both {
    # Shows pipeline output on screen AND writes it to the log
    param([Parameter(ValueFromPipeline = $true)]$InputObject)
    begin { $items = New-Object System.Collections.ArrayList }
    process { [void]$items.Add($InputObject) }
    end {
        if ($items.Count -eq 0) { return }
        $text = ($items | Out-String -Width 200).TrimEnd()
        if ($text.Trim()) { Write-Host $text; Write-Log $text }
    }
}

function Remove-RemoteInfo {
    # Removes the PSComputerName/RunspaceId columns that remote results carry
    param([Parameter(ValueFromPipeline = $true)]$InputObject)
    process {
        if ($null -eq $InputObject) { return }
        if ($InputObject -is [string] -or $InputObject -is [ValueType]) { $InputObject; return }
        if ($InputObject.PSObject.Properties['RunspaceId']) {
            $InputObject | Select-Object -Property * -ExcludeProperty PSComputerName, RunspaceId, PSShowComputerName
        } else { $InputObject }
    }
}

function Head {
    param([string]$Title)
    Clear-Host
    Say ('=== ' + $Title + ' ===') Cyan
    if (-not $Script:IsLocal) { Say ('Target: ' + $Script:Target + ' (REMOTE)') Magenta }
    if ($Script:DryRun) { Say 'DRY RUN is ON - changes are only described, not made.' Yellow }
    Write-Host ''
    Write-LogHeader $Title
}

function Show-SecretBanner {
    Say '!!! SENSITIVE - anyone who sees this can unlock drives or join networks !!!' Red
    if ($Script:LogSecrets) { Say 'These values are ALSO written to the log file (LogSecrets = $true).' DarkGray }
    Write-Host ''
}

function Open-File {
    # Opens through Explorer so browsers don't run with admin rights
    param([string]$Path)
    Start-Process -FilePath explorer.exe -ArgumentList ('"' + $Path + '"')
}

function Open-Logs { Start-Process -FilePath explorer.exe -ArgumentList ('"' + $Script:LogDir + '"') }

# ==================================================================
#  INPUT HELPERS - only valid keys do anything
# ==================================================================
function Read-YesNo {
    # Y/N question with a safe default. TimeoutSec 0 = wait forever.
    param([string]$Prompt, [ValidateSet('Y', 'N')][string]$Default = 'N', [int]$TimeoutSec = 15)
    $hint = 'y/N'; if ($Default -eq 'Y') { $hint = 'Y/n' }
    $auto = ''
    if ($TimeoutSec -gt 0) {
        $word = 'No'; if ($Default -eq 'Y') { $word = 'Yes' }
        $auto = " (auto-$word in $TimeoutSec s)"
    }
    Write-Host ("{0} [{1}]{2}: " -f $Prompt, $hint, $auto) -ForegroundColor Yellow -NoNewline
    while ([Console]::KeyAvailable) { [void][Console]::ReadKey($true) }   # ignore keys pressed earlier
    $deadline = (Get-Date).AddSeconds($TimeoutSec)
    while ($TimeoutSec -le 0 -or (Get-Date) -lt $deadline) {
        if ([Console]::KeyAvailable) {
            $c = [Console]::ReadKey($true).KeyChar.ToString().ToUpper()
            if ($c -eq 'Y' -or $c -eq 'N') { Write-Host $c; return ($c -eq 'Y') }
        }
        Start-Sleep -Milliseconds 100
    }
    Write-Host $Default
    return ($Default -eq 'Y')
}

function Read-ValidKey {
    param([string[]]$Keys)
    while ([Console]::KeyAvailable) { [void][Console]::ReadKey($true) }
    while ($true) {
        $c = [Console]::ReadKey($true).KeyChar.ToString().ToUpper()
        if ($Keys -contains $c) { return $c }
    }
}

function Confirm-Exit { return (Read-YesNo 'Exit the toolkit?' 'N' 0) }

function Exit-Toolkit {
    if ($Script:GraphConnected) { try { Disconnect-MgGraph | Out-Null } catch {} }
    Write-Log ("===== Toolkit closed {0:yyyy-MM-dd HH:mm:ss} =====" -f (Get-Date))
    Say ("Logs saved in: " + $Script:LogDir) Cyan
    Start-Sleep -Seconds 2
    exit
}

function Show-Nav {
    # Shown after every tool. Only B, M, L, Q work.
    Write-Host ''
    Say ('-' * 62) DarkCyan
    Write-Host ' [B] Back    [M] Main Menu    [L] Open Logs    [Q] Exit' -ForegroundColor Yellow
    Say ('-' * 62) DarkCyan
    while ($true) {
        $k = Read-ValidKey @('B', 'M', 'L', 'Q')
        if ($k -eq 'B') { return 'B' }
        if ($k -eq 'M') { return 'M' }
        if ($k -eq 'L') { Open-Logs }
        if ($k -eq 'Q') { if (Confirm-Exit) { Exit-Toolkit } }
    }
}

# ==================================================================
#  RUNNING THINGS ON THE TARGET (this PC or a remote PC)
# ==================================================================
function Invoke-OnTarget {
    param([scriptblock]$ScriptBlock, [object[]]$ArgumentList = @())
    if ($Script:IsLocal) { & $ScriptBlock @ArgumentList }
    else { Invoke-Command -ComputerName $Script:Target -ScriptBlock $ScriptBlock -ArgumentList $ArgumentList -ErrorAction Stop }
}

function Invoke-Change {
    # Anything that CHANGES a PC goes through here, so Dry Run can stop it
    param([string]$Description, [scriptblock]$ScriptBlock, [object[]]$ArgumentList = @())
    if ($Script:DryRun) {
        Say ("[DRY RUN] Would do on {0}: {1}" -f $Script:Target, $Description) Yellow
        Write-Log ("[DRY RUN] " + $Description)
        return
    }
    Write-Log ("ACTION: " + $Description)
    Invoke-OnTarget -ScriptBlock $ScriptBlock -ArgumentList $ArgumentList
}

function Invoke-NativeLive {
    # Runs SFC/DISM-style tools. Local = live progress. Remote = waits, then shows results.
    param([string]$Exe, [string]$Arguments, [switch]$Change, [switch]$HideRemoteOutput)
    if ($Change -and $Script:DryRun) {
        Say ("[DRY RUN] Would run on {0}: {1} {2}" -f $Script:Target, $Exe, $Arguments) Yellow
        Write-Log ("[DRY RUN] $Exe $Arguments")
        return $null
    }
    Write-Log ("RUN on {0}: {1} {2}" -f $Script:Target, $Exe, $Arguments)
    if ($Script:IsLocal) {
        $p = Start-Process -FilePath $Exe -ArgumentList $Arguments -NoNewWindow -Wait -PassThru
        $code = $p.ExitCode
    } else {
        Say ("Running on {0}. Live progress isn't shown for remote PCs - please wait..." -f $Script:Target) DarkGray
        $r = Invoke-Command -ComputerName $Script:Target -ErrorAction Stop -ArgumentList $Exe, $Arguments -ScriptBlock {
            param($e, $a)
            $out = & cmd.exe /c "$e $a" 2>&1
            [pscustomobject]@{
                Code = $LASTEXITCODE
                Out  = @($out | ForEach-Object { "$_" } | Where-Object { $_.Trim() -and $_ -notmatch '\[=|^\s*\d+(\.\d+)?%' })
            }
        }
        if (-not $HideRemoteOutput) { $r.Out | Out-Both }
        $code = $r.Code
    }
    Write-Log ("Exit code: $code")
    return $code
}

function Show-ExitStatus {
    param($Code, [string]$LogHint)
    if ($null -eq $Code) { return }
    Write-Host ''
    if ($Code -eq 0) { Say 'Done - exit code 0.' Green }
    else { Say ("Done - exit code {0}. Review: {1}" -f $Code, $LogHint) Yellow }
}

function Show-Simple {
    # Generic read-only tool: title + command, output shown and logged
    param([string]$Title, [scriptblock]$ScriptBlock, [switch]$Table)
    Head $Title
    $r = Invoke-OnTarget -ScriptBlock $ScriptBlock | Remove-RemoteInfo
    if ($Table) { $r | Format-Table -AutoSize -Wrap | Out-Both } else { $r | Out-Both }
}

function Invoke-RestorePointOffer {
    # Returns $true = go ahead, $false = cancel
    param([string]$Reason)
    if ($Script:DryRun) { Say '[DRY RUN] Would offer a restore point.' Yellow; return $true }
    Write-Host ''
    if (-not (Read-YesNo 'Create a restore point first? Recommended' 'Y' 15)) { return $true }
    Say 'Creating restore point, this can take a minute...' DarkGray
    try {
        Invoke-OnTarget -ArgumentList $Reason -ScriptBlock {
            param($r)
            Checkpoint-Computer -Description ("IT Toolkit - " + $r) -RestorePointType MODIFY_SETTINGS -ErrorAction Stop -WarningAction Stop
        }
        Say 'Restore point created.' Green
        Write-Log ("Restore point created before: " + $Reason)
        return $true
    } catch {
        Say ('Restore point was NOT created: ' + $_.Exception.Message) Yellow
        Say 'Common causes: System Protection is off, or one was already made in the last 24 hours.' DarkGray
        return (Read-YesNo 'Continue without a restore point?' 'N' 15)
    }
}

function Restart-Target {
    param([int]$DelaySec = 10)
    $msg = 'IT support is restarting this PC. Please save your work.'
    Invoke-Change ("Restart {0} in {1} seconds" -f $Script:Target, $DelaySec) -ArgumentList $DelaySec, $msg -ScriptBlock {
        param($t, $m)
        shutdown.exe /r /t $t /c $m
    }
}

function Invoke-RestartOffer {
    param([string]$Why)
    Write-Host ''
    Say $Why Yellow
    if ($Script:DryRun) { Say '[DRY RUN] Would offer a restart.' Yellow; return }
    if (Read-YesNo 'Restart now? Save work first' 'N' 30) {
        if ($Script:IsLocal) { Restart-Target 10; Say 'Restarting in 10 seconds...' Red }
        else { Restart-Target 60; Say ("Restart sent to {0}. The user gets a 60-second warning." -f $Script:Target) Green }
    } else { Say 'OK. Restart later when convenient.' DarkGray }
}

function Get-RemoteErrorHint {
    param([string]$Msg)
    if ($Msg -match 'Access is denied|AccessDenied') { return 'Access denied - your account needs admin rights on that PC' }
    if ($Msg -match 'cannot find the computer|could not be resolved|No such host|name is not valid|not resolve') { return 'Name not found - check spelling or DNS' }
    if ($Msg -match 'Kerberos|TrustedHosts') { return 'Authentication problem - use the computer name (not IP) from a domain-joined PC' }
    if ($Msg -match 'WinRM cannot complete the operation|cannot connect to the destination|The client cannot connect|timed out') { return 'Offline, blocked by firewall, or WinRM not enabled' }
    if ($Msg.Length -gt 120) { return $Msg.Substring(0, 120) + '...' }
    return $Msg
}

# ==================================================================
#  SCRIPTBLOCKS THAT RUN ON THE TARGET (self-contained on purpose)
# ==================================================================
$Script:SB_Header = {
    $os = Get-CimInstance Win32_OperatingSystem
    $c  = Get-CimInstance Win32_LogicalDisk -Filter "DeviceID='C:'"
    $pr = (Test-Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\RebootPending') -or
          (Test-Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update\RebootRequired')
    [pscustomobject]@{
        OS            = $os.Caption
        UptimeDays    = [math]::Round(((Get-Date) - $os.LastBootUpTime).TotalDays, 1)
        FreeGB        = [math]::Round($c.FreeSpace / 1GB)
        PendingReboot = [bool]$pr
    }
}

$Script:SB_TicketData = {
    $ErrorActionPreference = 'SilentlyContinue'
    $os   = Get-CimInstance Win32_OperatingSystem
    $cs   = Get-CimInstance Win32_ComputerSystem
    $bios = Get-CimInstance Win32_BIOS
    $c    = Get-CimInstance Win32_LogicalDisk -Filter "DeviceID='C:'"

    $pend = @()
    if (Test-Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\RebootPending') { $pend += 'CBS' }
    if (Test-Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update\RebootRequired') { $pend += 'WindowsUpdate' }
    $pendText = 'No'; if ($pend.Count -gt 0) { $pendText = 'YES (' + ($pend -join ', ') + ')' }

    $ds = dsregcmd.exe /status 2>$null
    $entra = 'No'; if ($ds -match 'AzureAdJoined\s*:\s*YES') { $entra = 'Yes' }

    $domain = 'Workgroup: ' + $cs.Workgroup; if ($cs.PartOfDomain) { $domain = $cs.Domain }

    $bl = 'Unknown'
    $blv = Get-BitLockerVolume -MountPoint 'C:'
    if ($blv) { $bl = "$($blv.ProtectionStatus) ($($blv.VolumeStatus))" }

    $lic = Get-CimInstance SoftwareLicensingProduct -Filter "PartialProductKey IS NOT NULL AND Name LIKE 'Windows%'" | Select-Object -First 1
    $licText = 'Unknown'
    switch ($lic.LicenseStatus) {
        0 { $licText = 'Unlicensed' }
        1 { $licText = 'Licensed' }
        5 { $licText = 'Notification mode' }
        { $_ -in 2, 3, 4, 6 } { $licText = 'Grace period' }
    }

    $def = 'Not available (third-party antivirus?)'
    $mp = Get-MpComputerStatus
    if ($mp) {
        $sigAge = [int]((Get-Date) - $mp.AntivirusSignatureLastUpdated).TotalDays
        $def = "Real-time: $($mp.RealTimeProtectionEnabled); signatures $sigAge days old"
    }

    $ip = Get-NetIPConfiguration | Where-Object { $_.IPv4DefaultGateway -and $_.NetAdapter.Status -eq 'Up' } | Select-Object -First 1
    $dns = ($ip.DNSServer | Where-Object { $_.AddressFamily -eq 2 } | ForEach-Object { $_.ServerAddresses }) -join ', '

    $errs = Get-WinEvent -FilterHashtable @{ LogName = 'System'; Level = 1, 2; StartTime = (Get-Date).AddDays(-1) } -MaxEvents 5 |
        ForEach-Object { '{0:MM-dd HH:mm} [{1}] {2}' -f $_.TimeCreated, $_.Id, (($_.Message -split "`r?`n")[0]).Trim() }

    [pscustomobject]@{
        Computer      = $env:COMPUTERNAME
        LoggedOnUser  = $cs.UserName
        Model         = "$($cs.Manufacturer) $($cs.Model)"
        SerialNumber  = $bios.SerialNumber
        OS            = "$($os.Caption) build $($os.BuildNumber)"
        LastBoot      = $os.LastBootUpTime
        UptimeDays    = [math]::Round(((Get-Date) - $os.LastBootUpTime).TotalDays, 1)
        PendingReboot = $pendText
        FreeGB_C      = [math]::Round($c.FreeSpace / 1GB)
        TotalGB_C     = [math]::Round($c.Size / 1GB)
        Domain        = $domain
        EntraJoined   = $entra
        IPv4          = ($ip.IPv4Address.IPAddress -join ', ')
        Gateway       = ($ip.IPv4DefaultGateway.NextHop -join ', ')
        DNS           = $dns
        BitLocker_C   = $bl
        Activation    = $licText
        Defender      = $def
        RecentErrors  = ($errs -join ' | ')
    }
}

$Script:SB_NetTest = {
    $res = @()
    $gw = Get-NetRoute -DestinationPrefix '0.0.0.0/0' -ErrorAction SilentlyContinue | Sort-Object RouteMetric | Select-Object -First 1 -ExpandProperty NextHop
    if ($gw) { $res += [pscustomobject]@{ Test = "1. Router ($gw)"; Pass = [bool](Test-Connection -ComputerName $gw -Count 2 -Quiet) } }
    else { $res += [pscustomobject]@{ Test = '1. Router - no default gateway found'; Pass = $false } }
    $res += [pscustomobject]@{ Test = '2. Internet by IP (1.1.1.1)'; Pass = [bool](Test-Connection -ComputerName 1.1.1.1 -Count 2 -Quiet) }
    $dnsOk = $false
    try { Resolve-DnsName www.microsoft.com -DnsOnly -ErrorAction Stop | Out-Null; $dnsOk = $true } catch {}
    $res += [pscustomobject]@{ Test = '3. DNS lookup (www.microsoft.com)'; Pass = $dnsOk }
    $ProgressPreference = 'SilentlyContinue'
    $https = Test-NetConnection www.microsoft.com -Port 443 -InformationLevel Quiet -WarningAction SilentlyContinue
    $res += [pscustomobject]@{ Test = '4. Secure web (HTTPS port 443)'; Pass = [bool]$https }
    $res
}

$Script:SB_WUReset = {
    # Microsoft's documented basic reset. Folders are renamed (not deleted) so it's reversible.
    $log = @()
    foreach ($s in 'bits', 'wuauserv', 'cryptsvc') { Stop-Service -Name $s -Force -ErrorAction SilentlyContinue; $log += "Stopped $s" }
    Remove-Item "$env:ALLUSERSPROFILE\Microsoft\Network\Downloader\qmgr*.dat" -Force -ErrorAction SilentlyContinue
    $log += 'Deleted BITS queue files (qmgr*.dat)'
    $stamp = Get-Date -Format 'yyyyMMdd_HHmmss'
    foreach ($t in "$env:SystemRoot\SoftwareDistribution\DataStore", "$env:SystemRoot\SoftwareDistribution\Download", "$env:SystemRoot\System32\catroot2") {
        if (Test-Path $t) {
            try { Rename-Item -Path $t -NewName ((Split-Path $t -Leaf) + ".bak_$stamp") -ErrorAction Stop; $log += "Renamed $t" }
            catch { $log += "FAILED to rename $t : $($_.Exception.Message)" }
        }
    }
    foreach ($s in 'cryptsvc', 'bits', 'wuauserv') { Start-Service -Name $s -ErrorAction SilentlyContinue; $log += "Started $s" }
    $log += "Old folders were kept as *.bak_$stamp - delete them once updates work again."
    $log
}

$Script:SB_BitLockerKeys = {
    $vols = Get-BitLockerVolume -ErrorAction SilentlyContinue
    if (-not $vols) { return 'BitLocker info not available (Home edition, or BitLocker not installed).' }
    foreach ($v in $vols) {
        $rp = @($v.KeyProtector | Where-Object { $_.KeyProtectorType -eq 'RecoveryPassword' })
        if ($rp.Count -eq 0) {
            [pscustomobject]@{ Drive = $v.MountPoint; Protection = "$($v.ProtectionStatus)"; KeyID = '(none)'; RecoveryKey = 'No recovery password on this drive' }
        }
        foreach ($k in $rp) {
            [pscustomobject]@{ Drive = $v.MountPoint; Protection = "$($v.ProtectionStatus)"; KeyID = $k.KeyProtectorId; RecoveryKey = $k.RecoveryPassword }
        }
    }
}

$Script:SB_WifiKeys = {
    # Note: reads English-language netsh output
    $profiles = netsh.exe wlan show profiles 2>$null | Select-String 'All User Profile\s*:\s*(.+)$' | ForEach-Object { $_.Matches[0].Groups[1].Value.Trim() }
    if (-not $profiles) { return 'No saved Wi-Fi profiles found (or the WLAN service is not running).' }
    foreach ($p in $profiles) {
        $detail = netsh.exe wlan show profile name="$p" key=clear 2>$null
        $key  = $detail | Select-String 'Key Content\s*:\s*(.+)$' | ForEach-Object { $_.Matches[0].Groups[1].Value.Trim() } | Select-Object -First 1
        $auth = $detail | Select-String 'Authentication\s*:\s*(.+)$' | ForEach-Object { $_.Matches[0].Groups[1].Value.Trim() } | Select-Object -First 1
        $pw = '(none stored - open network or enterprise login)'; if ($key) { $pw = $key }
        [pscustomobject]@{ Network = $p; Security = $auth; Password = $pw }
    }
}

function Update-HeaderInfo {
    try { $Script:HeaderInfo = Invoke-OnTarget -ScriptBlock $Script:SB_Header | Remove-RemoteInfo | Select-Object -First 1 }
    catch { $Script:HeaderInfo = $null }
}

# ==================================================================
#  DIAGNOSE
# ==================================================================
function Show-TicketSummary {
    Head 'Ticket Summary'
    Say 'Collecting, about 10-20 seconds...' DarkGray
    $d = Invoke-OnTarget -ScriptBlock $Script:SB_TicketData | Remove-RemoteInfo | Select-Object -First 1
    $body = ($d | Format-List | Out-String -Width 200).Trim()
    $text = "TICKET SUMMARY - {0} - {1:yyyy-MM-dd HH:mm}`r`n{2}" -f $d.Computer, (Get-Date), $body
    Write-Host $text
    Write-Log $text
    $file = Join-Path $Script:TicketDir ("TICKET_{0}_{1:yyyy-MM-dd_HHmm}.txt" -f $d.Computer, (Get-Date))
    Set-Content -Path $file -Value $text -Encoding UTF8
    Write-Host ''
    try { Set-Clipboard -Value $text; Say 'Copied to clipboard - paste it into the ticket.' Green } catch { Say 'Could not copy to clipboard.' Yellow }
    Say ("Saved: " + $file) DarkGray
    $warn = @()
    if ($d.UptimeDays -ge 14) { $warn += "Uptime is $($d.UptimeDays) days - a restart may fix it." }
    if ("$($d.PendingReboot)" -like 'YES*') { $warn += 'A restart is pending.' }
    if ($d.FreeGB_C -lt $Script:LowDiskGB) { $warn += "Low disk space: $($d.FreeGB_C) GB free." }
    if ($d.Activation -ne 'Licensed') { $warn += "Activation: $($d.Activation)" }
    if ($warn.Count -gt 0) {
        Write-Host ''
        Say 'Worth checking first:' Yellow
        foreach ($w in $warn) { Say ('  - ' + $w) Yellow }
    }
}

function Show-DriveHealth {
    Head 'Drive Health'
    Say 'Blank values are normal for some drives.' DarkGray
    Invoke-OnTarget { Get-PhysicalDisk | Select-Object FriendlyName, MediaType, HealthStatus, OperationalStatus, @{ n = 'SizeGB'; e = { [math]::Round($_.Size / 1GB) } } } |
        Remove-RemoteInfo | Format-Table -AutoSize | Out-Both
    Invoke-OnTarget { Get-PhysicalDisk | Get-StorageReliabilityCounter -ErrorAction SilentlyContinue | Select-Object DeviceId, Temperature, Wear, ReadErrorsUncorrected, PowerOnHours } |
        Remove-RemoteInfo | Format-Table -AutoSize | Out-Both
    Say 'File system check (read-only), may take a few minutes...' Cyan
    Invoke-OnTarget { chkdsk.exe C: } | Out-Both
}

function Show-PendingReboot {
    Head 'Pending Reboot Check'
    $r = Invoke-OnTarget {
        $pfro = (Get-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager' -Name PendingFileRenameOperations -ErrorAction SilentlyContinue).PendingFileRenameOperations
        [pscustomobject]@{
            ComponentServicing = [bool](Test-Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\RebootPending')
            WindowsUpdate      = [bool](Test-Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update\RebootRequired')
            PendingFileRename  = [bool]$pfro
        }
    } | Remove-RemoteInfo | Select-Object -First 1
    foreach ($p in 'ComponentServicing', 'WindowsUpdate', 'PendingFileRename') {
        $v = [bool]$r.$p
        Write-Host ('  {0,-20}' -f $p) -NoNewline
        if ($v) { Write-Host 'PENDING' -ForegroundColor Red } else { Write-Host 'clear' -ForegroundColor Green }
        Write-Log ("{0}: {1}" -f $p, $v)
    }
    Say 'Note: PendingFileRename is often set by antivirus or installers, so on its own it is a weak signal.' DarkGray
    if ($r.ComponentServicing -or $r.WindowsUpdate) { Invoke-RestartOffer 'Windows is waiting for a restart.' }
}

