function Clear-TeamsCache {
    Head 'Teams Cache Clear'
    $profiles = @(Invoke-OnTarget {
        Get-ChildItem "$env:SystemDrive\Users" -Directory -ErrorAction SilentlyContinue |
            Where-Object { $_.Name -notin 'Public', 'Default', 'Default User', 'All Users' } | ForEach-Object {
                $new = Join-Path $_.FullName 'AppData\Local\Packages\MSTeams_8wekyb3d8bbwe\LocalCache\Microsoft\MSTeams'
                $old = Join-Path $_.FullName 'AppData\Roaming\Microsoft\Teams'
                if ((Test-Path $new) -or (Test-Path $old)) { [pscustomobject]@{ User = $_.Name; NewTeams = (Test-Path $new); ClassicTeams = (Test-Path $old) } }
            }
    } | Remove-RemoteInfo)
    if ($profiles.Count -eq 0) { Say 'No Teams cache folders found.' Yellow; return }
    $i = 0
    foreach ($p in $profiles) { $i++; Write-Host ('  [{0}] ' -f $i) -ForegroundColor Yellow -NoNewline; Write-Host ('{0,-25} new Teams: {1,-6} classic: {2}' -f $p.User, $p.NewTeams, $p.ClassicTeams) }
    $n = "$(Read-Host 'Which user? Number (Enter to cancel)')".Trim()
    if (-not ($n -match '^\d+$' -and [int]$n -ge 1 -and [int]$n -le $profiles.Count)) { Say 'Cancelled.' Green; return }
    $u = $profiles[[int]$n - 1].User
    Say 'Teams will be closed for EVERY user on this PC, then the chosen user''s cache is cleared.' Yellow
    Say 'Their Teams settings (like theme) reset. Chats and files are safe - they live in the cloud.' DarkGray
    if (-not (Read-YesNo ("Clear Teams cache for {0}?" -f $u) 'N' 20)) { Say 'Cancelled. Nothing was changed.' Green; return }
    Invoke-Change ("Clear Teams cache for " + $u) -ArgumentList $u -ScriptBlock {
        param($user)
        Get-Process -Name 'ms-teams', 'Teams' -ErrorAction SilentlyContinue | Stop-Process -Force
        Start-Sleep -Seconds 2
        $base = Join-Path "$env:SystemDrive\Users" $user
        foreach ($p in (Join-Path $base 'AppData\Local\Packages\MSTeams_8wekyb3d8bbwe\LocalCache\Microsoft\MSTeams'), (Join-Path $base 'AppData\Roaming\Microsoft\Teams')) {
            if (Test-Path $p) { Get-ChildItem $p -Force | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue; "Cleared: $p" }
        }
        'Done. Teams can be opened again - the first start is slower.'
    } | Out-Both
}

