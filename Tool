function Show-Header {
    Clear-Host
    Say ('=' * 62) Cyan
    Say ("          IT ADMINISTRATION REPAIR TOOLKIT  v{0}" -f $Script:Version) Cyan
    Say ('=' * 62) Cyan
    Write-Host ' Target: ' -ForegroundColor DarkGray -NoNewline
    if ($Script:IsLocal) { Write-Host ("{0} (this PC)" -f $Script:Target) -ForegroundColor Green -NoNewline }
    else { Write-Host ("{0} (REMOTE)" -f $Script:Target) -ForegroundColor Magenta -NoNewline }
    if ($Script:DryRun) { Write-Host '    DRY RUN: ON' -ForegroundColor Yellow } else { Write-Host '' }
    $h = $Script:HeaderInfo
    if ($h) {
        Write-Host (' OS: ' + $h.OS) -ForegroundColor DarkGray
        $upColor = 'Green'; if ($h.UptimeDays -ge 14) { $upColor = 'Red' }
        $prColor = 'Green'; $prText = 'No'; if ($h.PendingReboot) { $prColor = 'Red'; $prText = 'YES' }
        $dkColor = 'Green'; if ($h.FreeGB -lt $Script:LowDiskGB) { $dkColor = 'Red' }
        Write-Host ' Uptime: ' -ForegroundColor DarkGray -NoNewline; Write-Host ("{0} days" -f $h.UptimeDays) -ForegroundColor $upColor -NoNewline
        Write-Host '   Pending reboot: ' -ForegroundColor DarkGray -NoNewline; Write-Host $prText -ForegroundColor $prColor -NoNewline
        Write-Host '   Free C: ' -ForegroundColor DarkGray -NoNewline; Write-Host ("{0} GB" -f $h.FreeGB) -ForegroundColor $dkColor
    } else { Say ' (target info unavailable)' DarkGray }
    Say ('=' * 62) Cyan
}

function Show-Menu {
    param([string]$Title, [array]$Items)
    while ($true) {
        Show-Header
        Say ('  ' + $Title) Cyan
        Say ('-' * 62) DarkCyan
        foreach ($i in $Items) {
            $label = $i.Label
            $color = 'Gray'
            if ($i.Danger) { $color = 'Red' }
            if ($i.LocalOnly -and -not $Script:IsLocal) { $color = 'DarkGray'; $label += ' (local only)' }
            Write-Host ('  [{0,2}] ' -f $i.Key) -ForegroundColor Yellow -NoNewline
            Write-Host $label -ForegroundColor $color
        }
        Say ('-' * 62) DarkCyan
        Write-Host '  [B] Back    [L] Open Logs    [Q] Exit' -ForegroundColor Yellow
        $sel = "$(Read-Host "`nSelect")".Trim().ToUpper()
        if (-not $sel) { continue }
        if ($sel -eq 'B') { return }
        if ($sel -eq 'L') { Open-Logs; continue }
        if ($sel -eq 'Q') { if (Confirm-Exit) { Exit-Toolkit }; continue }
        $item = $Items | Where-Object { $_.Key -eq $sel } | Select-Object -First 1
        if (-not $item) { Say 'Invalid choice.' Red; Start-Sleep -Seconds 1; continue }
        if ($item.LocalOnly -and -not $Script:IsLocal) { Say 'This tool only works on this PC. Change the target to THIS PC first.' Red; Start-Sleep -Seconds 2; continue }
        try { & $item.Action }
        catch {
            Say ('ERROR: ' + $_.Exception.Message) Red
            Write-Log ('ERROR: ' + $_.Exception.Message)
            if (-not $Script:IsLocal) { Say ('Hint: ' + (Get-RemoteErrorHint $_.Exception.Message)) DarkGray }
        }
        if ((Show-Nav) -eq 'M') { return }
    }
}

