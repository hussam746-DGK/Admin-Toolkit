    param([ValidateSet('battery', 'energy')][string]$Kind)
    Head ("{0} Report" -f $Kind.ToUpper())
    if ($Kind -eq 'energy') { Say 'This takes about 60 seconds...' DarkGray }
    $html = Invoke-OnTarget -ArgumentList $Kind -ScriptBlock {
        param($k)
        $tmp = Join-Path $env:TEMP ("tk_{0}-report.html" -f $k)
        if ($k -eq 'battery') { powercfg.exe /batteryreport /output $tmp | Out-Null } else { powercfg.exe /energy /output $tmp | Out-Null }
        if (Test-Path $tmp) { Get-Content -Path $tmp -Raw; Remove-Item $tmp -Force }
    }
    if (-not $html) { Say 'No report was created. (A battery report needs a battery.)' Yellow; return }
    $file = Join-Path $Script:LogDir ("{0}-report_{1}_{2:yyyy-MM-dd}.html" -f $Kind, $Script:Target, (Get-Date))
    Set-Content -Path $file -Value "$html" -Encoding UTF8
    Say ("Saved to: " + $file) Green
    if (Read-YesNo 'Open it now?' 'Y' 10) { Open-File $file }
}

