    if (-not $p[2]) { Say 'That panel only works on this PC.' Red; return }
    switch ($p[1]) {
        'compmgmt.msc' { Start-Process compmgmt.msc -ArgumentList ("/computer=\\" + $Script:Target) }
        'services.msc' { Start-Process services.msc -ArgumentList ("/computer=" + $Script:Target) }
