function Set-Target {
    param([string]$Name)
    $Name = "$Name".Trim()
    if (-not $Name -or $Name -eq $env:COMPUTERNAME -or $Name -eq 'localhost' -or $Name -eq '.') {
        $Script:Target = $env:COMPUTERNAME; $Script:IsLocal = $true
        Say 'Target set to THIS PC.' Green
        Write-Log 'Target changed to this PC'
        Update-HeaderInfo
        return
    }
    Say ("Testing remote connection to {0} ..." -f $Name) DarkGray
    try {
        Test-WSMan -ComputerName $Name -ErrorAction Stop | Out-Null
        Invoke-Command -ComputerName $Name -ScriptBlock { $env:COMPUTERNAME } -ErrorAction Stop | Out-Null
        $Script:Target = $Name; $Script:IsLocal = $false
        Say ("Connected. Target is now {0}." -f $Name) Green
        Write-Log ("Target changed to " + $Name)
        Update-HeaderInfo
    } catch {
        Say ("Can't manage {0} remotely: {1}" -f $Name, (Get-RemoteErrorHint $_.Exception.Message)) Red
        Say 'See Remote & Fleet > Remoting Setup Help.' DarkGray
    }
}

function Get-DomainComputers {
    try {
        $s = New-Object System.DirectoryServices.DirectorySearcher
        $s.Filter = '(&(objectCategory=computer)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))'   # enabled computers only
        $s.PageSize = 1000
        [void]$s.PropertiesToLoad.AddRange([string[]]@('name', 'operatingsystem', 'lastlogontimestamp'))
        foreach ($r in $s.FindAll()) {
            $ll = $null
            if ($r.Properties['lastlogontimestamp'].Count -gt 0) { $ll = [datetime]::FromFileTime([int64]$r.Properties['lastlogontimestamp'][0]) }
            [pscustomobject]@{ Name = [string]$r.Properties['name'][0]; OS = [string]$r.Properties['operatingsystem'][0]; LastLogon = $ll }
        }
    } catch {
        Say ('Could not read Active Directory: ' + $_.Exception.Message) Red
        Say 'Run the toolkit on a domain-joined PC, signed in with a domain account.' DarkGray
    }
}

function Select-DomainComputer {
    Head 'Browse Domain Computers'
    Say 'Reading Active Directory...' DarkGray
    $all = @(Get-DomainComputers)
    if ($all.Count -eq 0) { return }
    $filter = "$(Read-Host 'Filter by name (Enter for all)')".Trim()
    $shown = @($all | Where-Object { -not $filter -or $_.Name -like "*$filter*" } | Sort-Object Name | Select-Object -First 200)
    if ($shown.Count -eq 0) { Say 'No matches.' Yellow; return }
    $i = 0
    foreach ($c in $shown) {
        $i++
        $ll = ''; if ($c.LastLogon) { $ll = $c.LastLogon.ToString('yyyy-MM-dd') }
        Write-Host ('  [{0,3}] ' -f $i) -ForegroundColor Yellow -NoNewline
        Write-Host ('{0,-18} {1,-32} last seen {2}' -f $c.Name, $c.OS, $ll)
    }
    if ($all.Count -gt 200) { Say 'Showing the first 200. Use the filter to narrow it down.' DarkGray }
    $n = "$(Read-Host 'Number to make the target (Enter to cancel)')".Trim()
    if ($n -match '^\d+$' -and [int]$n -ge 1 -and [int]$n -le $shown.Count) { Set-Target $shown[[int]$n - 1].Name }
}

function Get-FleetList {
    Write-Host '  [1] ' -ForegroundColor Yellow -NoNewline; Write-Host 'All enabled computers in the domain'
    Write-Host '  [2] ' -ForegroundColor Yellow -NoNewline; Write-Host 'Computers listed in targets.txt (one name per line)'
    Write-Host '  [B] ' -ForegroundColor Yellow -NoNewline; Write-Host 'Cancel'
    $c = Read-ValidKey @('1', '2', 'B')
    if ($c -eq 'B') { return @() }
    if ($c -eq '1') { $list = @(Get-DomainComputers | ForEach-Object { $_.Name }) }
    else {
        $f = Join-Path $Script:Root 'targets.txt'
        if (-not (Test-Path $f)) {
            Set-Content -Path $f -Value '# One computer name per line. Lines starting with # are ignored.'
            Say ("Created {0} - add computer names, then try again." -f $f) Yellow
            return @()
        }
        $list = @(Get-Content $f | Where-Object { $_ -and $_ -notmatch '^\s*#' } | ForEach-Object { $_.Trim() })
    }
    $list = @($list | Where-Object { $_ } | Sort-Object -Unique)
    Say ("{0} computers in the list." -f $list.Count) Cyan
    return $list
}

function Get-UnreachableRows {
    param($Errors)
    foreach ($e in @($Errors)) {
        if (-not $e) { continue }
        if (-not ($e.Exception -is [System.Management.Automation.Remoting.PSRemotingTransportException])) { continue }
        $name = $e.TargetObject
        if (-not ($name -is [string]) -or -not $name) { $name = $e.CategoryInfo.TargetName }
        if (-not $name) { $name = $e.OriginInfo.PSComputerName }
        [pscustomobject]@{ Computer = "$name"; Detail = (Get-RemoteErrorHint $e.Exception.Message) }
    }
}

function Invoke-FleetStatus {
    Head 'Fleet Status - which PCs can I reach?'
    $list = @(Get-FleetList)
    if ($list.Count -eq 0) { return }
    Say 'Checking... unreachable PCs take a few seconds each to time out.' DarkGray
    $opt = New-PSSessionOption -OpenTimeout 8000 -OperationTimeout 60000
    $errs = $null
    $ok = @(Invoke-Command -ComputerName $list -SessionOption $opt -ThrottleLimit $Script:ThrottleLimit -ErrorAction SilentlyContinue -ErrorVariable errs -ScriptBlock {
        $os = Get-CimInstance Win32_OperatingSystem
        [pscustomobject]@{ UptimeDays = [math]::Round(((Get-Date) - $os.LastBootUpTime).TotalDays, 1); User = (Get-CimInstance Win32_ComputerSystem).UserName }
    })
    $rows = @()
    foreach ($r in $ok) { $rows += [pscustomobject]@{ Computer = $r.PSComputerName; Status = 'Reachable'; UptimeDays = $r.UptimeDays; User = $r.User; Detail = '' } }
    foreach ($b in @(Get-UnreachableRows $errs)) { $rows += [pscustomobject]@{ Computer = $b.Computer; Status = 'UNREACHABLE'; UptimeDays = ''; User = ''; Detail = $b.Detail } }
    foreach ($r in ($rows | Sort-Object Status, Computer)) {
        $color = 'Green'; if ($r.Status -ne 'Reachable') { $color = 'Red' }
        Write-Host ('  {0,-18} {1,-12} {2,6} {3,-25} {4}' -f $r.Computer, $r.Status, $r.UptimeDays, $r.User, $r.Detail) -ForegroundColor $color
    }
    $file = Join-Path $Script:FleetDir ("FleetStatus_{0:yyyy-MM-dd_HHmm}.csv" -f (Get-Date))
    $rows | Export-Csv -Path $file -NoTypeInformation -Encoding UTF8
    Write-Host ''
    Say ("Reachable: {0} of {1}. Saved: {2}" -f $ok.Count, $list.Count, $file) Cyan
    Write-Log ("Fleet status: " + $file)
}

function Invoke-FleetInventory {
    Head 'Fleet Inventory'
    $list = @(Get-FleetList)
    if ($list.Count -eq 0) { return }
    Say 'Collecting from all reachable PCs at once. This can take a few minutes.' DarkGray
    $opt = New-PSSessionOption -OpenTimeout 8000 -OperationTimeout 180000
    $errs = $null
    $rows = @(Invoke-Command -ComputerName $list -ScriptBlock $Script:SB_TicketData -SessionOption $opt -ThrottleLimit $Script:ThrottleLimit -ErrorAction SilentlyContinue -ErrorVariable errs | Remove-RemoteInfo)
    $file = Join-Path $Script:FleetDir ("Inventory_{0:yyyy-MM-dd_HHmm}.csv" -f (Get-Date))
    $rows | Export-Csv -Path $file -NoTypeInformation -Encoding UTF8
    Say ('  {0,-18} {1,7} {2,-7} {3,7} {4,-13} {5}' -f 'Computer', 'Uptime', 'Reboot', 'FreeGB', 'Activation', 'Needs attention') Cyan
    foreach ($r in ($rows | Sort-Object Computer)) {
        $flags = @()
        $reboot = 'no'; if ("$($r.PendingReboot)" -like 'YES*') { $reboot = 'YES'; $flags += 'reboot pending' }
        if ($r.UptimeDays -ge 14) { $flags += 'long uptime' }
        if ($r.FreeGB_C -lt $Script:LowDiskGB) { $flags += 'low disk' }
        if ($r.Activation -ne 'Licensed') { $flags += 'activation' }
        $color = 'Green'; if ($flags.Count -gt 0) { $color = 'Yellow' }
        Write-Host ('  {0,-18} {1,6}d {2,-7} {3,7} {4,-13} {5}' -f $r.Computer, $r.UptimeDays, $reboot, $r.FreeGB_C, $r.Activation, ($flags -join ', ')) -ForegroundColor $color
    }
    $bad = @(Get-UnreachableRows $errs)
    foreach ($b in $bad) { Write-Host ('  {0,-18} UNREACHABLE - {1}' -f $b.Computer, $b.Detail) -ForegroundColor Red }
    if ($bad.Count -gt 0) { $bad | Export-Csv -Path ($file -replace '\.csv$', '_unreachable.csv') -NoTypeInformation -Encoding UTF8 }
    Write-Host ''
    Say ("Reached {0} of {1}. Saved: {2}" -f $rows.Count, $list.Count, $file) Cyan
    Write-Log ("Fleet inventory: " + $file)
}

